
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum MarketStatus {
  open
  closed
  resolved
}

enum Outcome {
  YES
  NO
}

enum Side {
  YES
  NO
}

enum TransactionType {
  bet
  payout
  refund
}

enum LogStatus {
  success
  timeout
  error
}

enum AgentKind {
  external // brings-your-own webhook
  builtin  // ships with Arena
  hosted   // Arena runs it from a user-supplied strategy prompt
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  agents Agent[]
  markets Market[]
}

model Agent {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields:[userId], references:[id])
  name String
  endpointUrl String?
  kind AgentKind @default(external)
  persona String? // built-in persona key, e.g. "analyst"
  // identity & reasoning
  archetype String?   // strategy archetype key (see agents/archetypes.js)
  strategy String?    // freeform strategy description (hosted agents)
  systemPrompt String? @db.Text // the reasoning prompt Arena runs (hosted agents)
  model String?       // which LLM the agent reasons with
  bio String?         // public one-liner
  emblem String?      // emoji/glyph identity
  balance Int @default(1000) // starting balance
  createdAt DateTime @default(now())
  positions Position[]
  transactions Transaction[]
  logs Log[]
  active Boolean @default(true)
}

model Market{
  id String @id @default(cuid())
  creatorId String?
  creator User? @relation(fields:[creatorId], references: [id])
  status MarketStatus @default(open)
  opensAt DateTime
  closesAt DateTime
  resolvedAt DateTime?
  outcome Outcome?
  category String?
  autoResolve Boolean @default(false)
  resolverKey String? // which real-world resolver decides this market (null => coinflip stub)
  resolverData Json?  // resolver baseline captured at creation (e.g. reference price)
  announced Boolean @default(false) // engine has fanned out to agents
  positions Position[]
  transactions Transaction[]
  logs Log[]
  snapshots Snapshot[]
  createdAt DateTime @default(now())
  question String
  description String
  resolutionCriteria String
}

model Position{
  id String @id @default(cuid())
  agentId String
  marketId String
  market Market @relation(fields:[marketId], references: [id])
  agent Agent @relation(fields: [agentId], references : [id])
  side Side
  amount Int
  confidence Float
  thesis String? @db.Text // the agent's public reasoning for this position
  createdAt DateTime @default(now())

  @@index([marketId])
  @@index([agentId])
}

model Transaction{
  id String @id @default(cuid())
  agentId String
  marketId String
  market Market @relation(fields:[marketId], references: [id])
  agent Agent @relation(fields: [agentId], references : [id])
  amount Int
  type TransactionType
  createdAt DateTime @default(now())

  @@index([agentId])
}

model Log{
  id String @id @default(cuid())
  agentId String
  marketId String
  market Market @relation(fields:[marketId], references: [id])
  agent Agent @relation(fields: [agentId], references : [id])
  status LogStatus
  latencyMs Int
  createdAt DateTime @default(now())
  requestPayload Json
  responsePayload Json

  @@index([agentId])
  @@index([marketId])
}

// Time series of a market's odds — powers charts and records the aggregate forecast.
model Snapshot{
  id String @id @default(cuid())
  marketId String
  market Market @relation(fields:[marketId], references: [id])
  yesPool Int
  noPool Int
  yesProb Float
  createdAt DateTime @default(now())

  @@index([marketId])
}
