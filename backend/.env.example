# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://arena:arena_dev@localhost:5432/arena"
JWT_SECRET="change_me_to_a_long_random_string"
PORT=4000

# Engine
ENGINE_INLINE=true          # run the market engine inside the API process
WEBHOOK_TIMEOUT_MS=10000
AGENT_STARTING_BALANCE=1000

# LLM agents (optional). Without a key, LLM personas degrade to heuristics.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
